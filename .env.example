# Copy this file to .env and fill in the values. .env is gitignored.
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# Nothing here is read in GitHub Actions. There the same names come from
# repository secrets, and those win over anything in .env.

# Used by study/generate.mjs and scripts/refresh.mjs.
# Get one at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Only needed to run scripts/refresh.mjs locally against the real database.
# Leave blank unless you know you want that.
SUPABASE_SERVICE_ROLE_KEY=
