# Secrets. Never commit these.
.env
.env.local
.env.*.local

# Corpus documents from anyone else stay off this public repository, whatever
# the source directory is called. Publish the rates and the manifests, not the
# text. The manifests are .tsv and stay tracked, which is what makes a result
# reproducible without republishing somebody's article.
study/corpus/*/*.txt

# Except the AI set, which is our own generated output and belongs in the repo.
!study/corpus/ai/*.txt

# For a document you own outright, override deliberately:
#   git add -f study/corpus/human/your-own-post.txt

node_modules/
.DS_Store
