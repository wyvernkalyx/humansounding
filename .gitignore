# Secrets. Never commit these.
.env
.env.local
.env.*.local

# Corpus documents from anyone else stay off this public repository, whatever
# the source directory is called. Publish the rates and the manifests, not the
# text. The manifests are .tsv and stay tracked, which is what makes a result
# reproducible without republishing somebody's article.
study/corpus/*/*.txt

# Except the AI sets, which are our own generated output and belong in the repo.
# Every vendor, documents and chat alike: a study nobody can rerun against the
# same text is not reproducible, and this text is ours to publish.
!study/corpus/ai/*.txt
!study/corpus/ai-*/*.txt
!study/corpus/chat-*/*.txt

# Superseded generations stay local. They are kept for provenance, not for
# publication, and they must never be measured alongside the run that replaced
# them. (This directory sits two levels deep, so the rule above does not reach
# it; that is how 64 of them reached the public repo on 2026-08-28.)
**/superseded-alias-run/

# For a document you own outright, override deliberately:
#   git add -f study/corpus/human/your-own-post.txt

node_modules/
.DS_Store

# Newsletter arm: the manifest lists which newsletters Gregg subscribes to,
# which is personal information. Rates and derived counts are publishable; this is not.
study/corpus/newsletter/MANIFEST.tsv

# Corpus archives contain third-party human text. Never commit.
study/**/*.tgz
study/*.tgz

_to_delete/

# Peer study data. Derived tables are fine to commit; verbatim third-party
# Reddit text is not, same rule as study/corpus/*/*.txt.
study/peer/*/quote_bank.txt
study/peer/*/synthesis.md
